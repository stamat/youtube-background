{
  "name": "youtube-background",
  "version": "1.2.0",
  "description": "ESM / jQuery plugin for creating video backgrounds from YouTube, Vimeo or video file links.",
  "main": "jquery.youtube-background.js",
  "exports": {
    ".": {
      "import": "./src/main.mjs",
      "default": "./jquery.youtube-background.js"
    },
    "./*": "./*"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "!src/__tests__",
    "!src/styles",
    "jquery.youtube-background.js",
    "jquery.youtube-background.js.map",
    "jquery.youtube-background.min.js",
    "youtube-background-experimental.js",
    "youtube-background-experimental.js.map",
    "youtube-background-experimental.min.js"
  ],
  "homepage": "https://github.com/stamat/youtube-background",
  "repository": {
    "type": "git",
    "url": "https://github.com/stamat/youtube-background.git"
  },
  "keywords": [
    "youtube",
    "background",
    "jquery",
    "embed",
    "jquery-plugin",
    "youtube-embed",
    "youtube-embed-player",
    "javascript",
    "video-background"
  ],
  "author": "Nikola Stamatovic <@stamat>",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stamat/youtube-background/issues"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "poops": "^1.9.4",
    "poops-docs-theme": "^1.1.2"
  },
  "scripts": {
    "dev": "poops",
    "build": "poops -b",
    "test": "NODE_OPTIONS='--experimental-vm-modules' npx jest",
    "lint": "npx eslint ."
  },
  "dependencies": {
    "book-of-spells": "^1.3.1"
  }
}
