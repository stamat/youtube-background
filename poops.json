{
  "scripts": [
    {
      "in": "src/main.mjs",
      "out": "jquery.youtube-background.js",
      "options": {
        "sourcemap": true,
        "minify": true,
        "format": "iife",
        "target": "es2019"
      }
    },
    {
      "in": "src/experimental.mjs",
      "out": "youtube-background-experimental.js",
      "options": {
        "sourcemap": true,
        "minify": true,
        "format": "iife",
        "target": "es2019"
      }
    },
    {
      "in": "node_modules/poops-docs-theme/src/prose.ts",
      "out": "js/prose.js",
      "options": {
        "minify": true,
        "justMinified": true,
        "format": "iife",
        "target": "es2019"
      }
    }
  ],
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve": {
    "port": 4040
  },
  "livereload": true,
  "watch": [
    "src"
  ],
  "includePaths": [
    "node_modules"
  ],
  "styles": [
    {
      "in": "src/styles/prose.scss",
      "out": "css/prose.css",
      "options": {
        "minify": true,
        "justMinified": true
      }
    }
  ],
  "markup": {
    "in": "src/markup",
    "out": ".",
    "site": {
      "title": "Youtube Background",
      "brand": "youtube-background",
      "brandMark": "📺",
      "description": "ESM / jQuery plugin for creating video backgrounds from YouTube, Vimeo or video file links.",
      "lang": "en",
      "url": "https://stamat.github.io/youtube-background",
      "repo": "https://github.com/stamat/youtube-background",
      "branch": "master",
      "links": [
        {
          "title": "npm",
          "url": "https://www.npmjs.com/package/youtube-background"
        }
      ]
    }
  }
}
