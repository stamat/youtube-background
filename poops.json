{
  "scripts": [
    {
      "in": "src/main.mjs",
      "out": "dist/youtube-background.js",
      "options": {
        "sourcemap": true,
        "minify": true,
        "format": "iife",
        "target": "es2019"
      }
    },
    {
      "in": "src/controls.mjs",
      "out": "dist/youtube-background-controls.js",
      "options": {
        "sourcemap": true,
        "minify": true,
        "format": "iife",
        "target": "es2019"
      }
    },
    {
      "in": "node_modules/poops-docs-theme/src/prose.ts",
      "out": "_site/js/prose.js",
      "options": {
        "minify": true,
        "justMinified": true,
        "format": "iife",
        "target": "es2019"
      }
    }
  ],
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve": {
    "port": 4040,
    "base": "/_site"
  },
  "livereload": true,
  "watch": [
    "src",
    "site"
  ],
  "includePaths": [
    "node_modules"
  ],
  "styles": [
    {
      "in": "src/styles/controls.scss",
      "out": "dist/youtube-background-controls.css",
      "options": {
        "minify": true
      }
    },
    {
      "in": "site/prose.scss",
      "out": "_site/css/prose.css",
      "options": {
        "minify": true,
        "justMinified": true
      }
    }
  ],
  "copy": [
    {
      "in": [
        "dist/youtube-background.min.js",
        "dist/youtube-background-controls.min.js"
      ],
      "out": "_site"
    }
  ],
  "markup": {
    "in": "site",
    "out": "_site",
    "options": {
      "site": {
        "title": "Youtube Background",
        "brand": "youtube-background",
        "brandMark": "📺",
        "description": "ESM module and standalone script for creating video backgrounds from YouTube, Vimeo or video file links.",
        "lang": "en",
        "url": "https://stamat.github.io/youtube-background",
        "repo": "https://github.com/stamat/youtube-background",
        "branch": "master",
        "iconLinks": [
          {
            "title": "npm",
            "url": "https://www.npmjs.com/package/youtube-background",
            "icon": "npm"
          }
        ]
      }
    }
  }
}
